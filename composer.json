{
    "name": "puggan/untrusted-value",
    "description": "Turn untrusted input values into type-safe values, with optional validation.",
    "type": "library",
    "license": "MIT",
    "keywords": ["validation", "type-safety", "input", "untrusted", "sanitize"],
    "authors": [
        {
            "name": "Thorbjörn Puggan Sundragon",
            "email": "puggan@sundragon.se"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Puggan\\UntrustedValue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puggan\\UntrustedValue\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    }
}
